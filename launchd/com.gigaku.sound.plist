<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.gigaku.sound</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/USERNAME/gigaku/launchd/GigakuSound.app/Contents/MacOS/GigakuSound</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/tmp/gigaku-sound.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/gigaku-sound.log</string>
</dict>
</plist>
